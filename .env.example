# Copy to .env (gitignored). Secrets stay out of git.

# Maximum upload size in bytes. Default 50 MiB.
# MAX_UPLOAD_BYTES=52428800
DATA_DIR=data
# One directory under data/sessions/. Default local.
# SESSION_ID=local

# Each accepted workbook runs in its own process.
# How many of those processes may run at once. Default 2.
# A blank, 0, or negative value keeps that default.
# MAX_CONCURRENT_JOBS=2

# Server: stop a book's process after this many seconds.
# scripts/run.sh reads the same name as a client poll. If it is unset in the
# shell, the script waits 300s and leaves the process running.
JOB_TIMEOUT_SEC=3600

# Legacy .xls books are converted to .xlsx by LibreOffice headless.
# Path or name of soffice. Default: soffice or libreoffice on PATH.
# Without it a .xls upload is rejected with unsupported_media_type.
# SOFFICE_BIN=/usr/bin/soffice
# Stop one conversion after this many seconds. Default 300.
# XLS_CONVERT_TIMEOUT_SEC=300
LOG_LEVEL=INFO
LOG_JSON=true
