# Copy to .env (gitignored). Secrets stay out of git.

# Maximum upload size in bytes. Default 50 MiB.
# MAX_UPLOAD_BYTES=52428800
DATA_DIR=data
# Refuse to start when DATA_DIR is on a network filesystem (nfs, cifs/smb,
# fuse.sshfs, afp, webdav). Linux checks /proc/mounts, then statfs. macOS
# checks statfs, then `mount`. If the type cannot be detected, startup logs
# and continues. Default false.
# DATA_DIR_ALLOW_NETWORK_FS=false
# One directory under data/sessions/. Default local.
# Must match SESSION_ID_PATTERN and SESSION_ID_MAX_LENGTH. The default pattern
# is one segment: a letter or digit, then letters, digits, "_" or "-".
# A separator or ".." is rejected at startup.
# SESSION_ID=local
# SESSION_ID_PATTERN=^[A-Za-z0-9][A-Za-z0-9_-]*$
# SESSION_ID_MAX_LENGTH=64

# Each accepted workbook runs in its own process.
# How many of those processes may run at once. Default 4.
# A blank, 0, or negative value keeps that default.
# The slot count does not divide the per-job RSS cap.
# MAX_CONCURRENT_JOBS=4

# RSS cap for one job, in bytes. When unset, the cap is the lesser of
# (cgroup memory limit minus JOB_MEMORY_API_RESERVE_FRACTION) and
# JOB_MEMORY_DEFAULT_BUDGET_BYTES. The reserve covers the API process and the
# embedded worker in that cgroup. Slots do not divide the remainder.
# An explicit value wins and is not clipped by the 1536 MiB ceiling.
# A blank or non-positive value keeps the derived cap.
# With no cgroup limit and no value here, the cap is
# JOB_MEMORY_DEFAULT_BUDGET_BYTES (1536 MiB).
# JOB_MEMORY_BUDGET_BYTES=

# Fraction of the cgroup limit kept for the API process, in (0, 1). Default 0.25.
# Admission blocks a new job when free anonymous memory is below this share.
# JOB_MEMORY_API_RESERVE_FRACTION=0.25

# Budget used when the cgroup reports no limit and JOB_MEMORY_BUDGET_BYTES is
# unset. Also the ceiling when a cgroup limit is known. Default 1536 MiB.
# Must be a positive integer.
# JOB_MEMORY_DEFAULT_BUDGET_BYTES=1610612736

# How often the parent samples a child's resident set, in seconds. Default 0.2.
# JOB_MEMORY_WATCH_INTERVAL_SEC=0.2

# Cells kept from one bounded range that is expanded per formula. Only ranges
# up to RANGE_NODE_MIN_CELLS expand that way, so this cap matters only when it
# is set below that size. Default 2000.
# RANGE_EXPAND_CAP=2000

# A whole column or row, or a rectangle over this many cells, is one range node:
# the formula gets one edge to it and its cells come from its bounds. Smaller
# ranges expand per formula, blank members included. Default 64.
# RANGE_NODE_MIN_CELLS=64

# Members of one range node a trace lists before it says how many it left out
# (members_total / members_shown on the edge). 0 lists all. Default 200.
# TRACE_RANGE_MEMBERS=200

# oom_score_adj written by the child when the kernel allows it. -1000..1000.
# Default 1000 (prefer killing this process).
# JOB_OOM_SCORE_ADJ=1000

# Stream .xlsx sheets with iterparse and write raw cells from column lists.
# Raw cells.parquet and cell_presence.parquet stay one row group, byte-identical
# to the single-table writer. Default true. Set false for the previous DOM parse.
# PARSE_STREAMING=true

# Write context.json and other job JSON with json.dump, not json.dumps.
# The documents stay byte-identical. Default true.
# JSON_STREAM=true

# Row-group size for formula IR and graph parquet. Default 65536.
# 0 writes one row group and keeps those files byte-identical to the
# single-table writer. A group smaller than the table changes file bytes
# and not the cell values. Raw cells and presence ignore this setting.
# PARQUET_ROW_GROUP_ROWS=65536

# Compile-local pool of repeated node ids. It is dropped when compile finishes.
# This is not sys.intern. Default true.
# COMPILE_STRING_POOL=true

# Keep each formula AST as zlib bytes until layout relations have read it.
# cells.parquet and the published JSON still store the plain AST JSON. Default true.
# COMPILE_AST_ZLIB=true

# Write cell edges as column batches, enrich them from those row groups, and
# stream graph.json / graph.md. The in-memory cell-edge list is not kept.
# Default true. Set false to build CellEdge rows and a second edge list.
# GRAPH_STREAM=true

# Read indent and outline from Arrow. An all-zero book does not build the
# raw-cell dict list. layout_cells_read is still logged. Default true.
# LAYOUT_COLUMNAR_FACTS=true

# glibc MALLOC_ARENA_MAX for a spawned job child. Default 2.
# 0 or a blank value leaves an inherited MALLOC_ARENA_MAX in place and does
# not clear it. A positive value is applied only around the child start and
# then restored on the parent. A one-process `finance-context build` keeps
# whatever the shell exported, because glibc reads the variable at startup.
# Ignored where the allocator does not use this variable.
# JOB_MALLOC_ARENA_MAX=2

# Call malloc_trim after each pipeline stage (parse, compile, layout, graph,
# build, render). Default true. Where libc has no malloc_trim, the call is skipped.
# JOB_MALLOC_TRIM=true

# Shared RQ queue. The API and `finance-context worker` both use this address.
# There is no in-process fallback. The URL has no credentials. Leave the next
# two unset for no AUTH: the client does not pass username or password. A
# non-empty value overrides that one field of the URL userinfo.
# REDIS_USERNAME without a password, here or in the URL, is rejected. Neither
# value is written to logs.
# Settings default, when REDIS_URL is unset: redis://redis:6379/0.
# Compose does not set REDIS_URL. It comes from this file.
# Local testing with deploy/docker-compose.override.yml (redis:8.6.7-alpine).
# One finance-context container and Redis share the project network:
# REDIS_URL=redis://redis:6379/0
# A process on the host uses the published port of that Redis:
# REDIS_URL=redis://127.0.0.1:6379/0
# Production does not use the override. Redis comes from outside, for example
# the user's finance-stack compose. From these containers, host.docker.internal
# is the host gateway. On Linux that is the bridge address, not 127.0.0.1.
# Redis has to listen on that address, or on another non-public address the
# containers can reach. A loopback-only listener is not reachable from them.
# REDIS_URL=redis://host.docker.internal:6379/0
# REDIS_USERNAME=
# REDIS_PASSWORD=
# Socket connect and read timeout for the API client and `worker --check`, in seconds.
# The worker's own blocking pop does not use this timeout.
# REDIS_CONNECT_TIMEOUT_SEC=2
# One queue name. The session id is in the job id `{SESSION_ID}--{job_id}`, not a queue.
# QUEUE_NAME=finance-context
# Queued, started, and delayed jobs for one SESSION_ID. Above this, POST is 429.
# JOB_QUEUE_MAX_PER_SESSION=3
# Added to JOB_TIMEOUT_SEC and both stop pauses to form RQ's job timeout.
# QUEUE_JOB_TIMEOUT_MARGIN_SEC=120
# 0 means a queued job waits without an RQ ttl. A positive value is seconds.
# QUEUE_JOB_TTL_SEC=0
# How long a finished RQ record stays. 0 deletes it immediately.
# QUEUE_RESULT_TTL_SEC=3600
# How long a failed RQ record stays, so a lost job can still be seen.
# QUEUE_FAILURE_TTL_SEC=604800
# Retries after a lost worker or horse. 0 disables them. Pipeline errors and OOM do not use this.
# JOB_RETRY_ON_LOST=1
# Seconds before the next attempt when another session holds
# shared/books/{job_id}/.lock. The child tries LOCK_NB and raises SharedCacheBusy.
# The RQ horse returns Retry(interval) and releases the worker slot. It does not
# sleep. CLI `finance-context build` still waits in-process, and that wait stops
# before JOB_TIMEOUT_SEC. 0 is not allowed.
# SHARED_CACHE_BUSY_RETRY_SEC=30
# Extra attempts after the first busy result. 0 fails immediately with error
# shared_cache_busy. The same error is recorded when the retries are exhausted.
# SHARED_CACHE_BUSY_MAX_RETRIES=120
# When true, a horse whose cgroup has no room for another job of this budget
# requeues instead of spawning. Missing cgroup numbers (macOS) do not requeue.
# JOB_ADMISSION_CGROUP_CHECK=true
# Seconds before that deferred job is tried again. The worker slot is free meanwhile.
# JOB_ADMISSION_RETRY_SEC=30
# How often a spawn child, and a horse, notice that their parent pid changed.
# JOB_PARENT_WATCH_INTERVAL_SEC=1.0
# Retry-After on 429 and on 503 when Redis is down, in whole seconds.
# JOB_RETRY_AFTER_SEC=30
# The horse stops the spawn child with SIGTERM, waits, then SIGKILL, and waits again.
# JOB_TERMINATE_GRACE_SEC=5
# JOB_KILL_GRACE_SEC=5
# Threads for blocking API work (files, hashes, JSON, and the RQ client).
# 40 is AnyIO's default. /healthz does no I/O and does not take a thread.
# API_THREAD_LIMIT=40
# How long /readyz reuses one DATA_DIR writability check and Redis ping, in seconds.
# The usual probe uses an unnamed inode (O_TMPFILE) and leaves no directory entry.
# A filesystem that rejects that flag creates a short-lived .ready- file, writes
# one byte, and unlinks it. A failed check is 503 until the cache expires.
# A supervised embedded worker that is down is 503 immediately. That check is
# not held for this long.
# READYZ_CACHE_TTL_SEC=10
# `finance-context serve` starts the RQ pool as a child. false is API-only;
# `finance-context worker` is still the standalone pool.
# EMBEDDED_WORKER=true
# Seconds before that child is started again after it exits. /readyz is not
# ready while the child is down, including this wait.
# EMBEDDED_WORKER_RESTART_BACKOFF_SEC=1
# Progress events for one job, on a Redis stream. Publishing never fails the job.
# Approximate cap, then the key's TTL in seconds after a terminal event.
# JOB_EVENTS_MAXLEN=256
# JOB_EVENTS_TTL_SEC=3600
# SSE comment interval, in seconds, and how many event streams may be open.
# JOB_EVENTS_HEARTBEAT_SEC=15
# JOB_EVENTS_MAX_CONNECTIONS=32

# Server: stop a book's process after this many seconds.
# scripts/run.sh reads the same name as a client poll. If it is unset in the
# shell, the script waits 300s and leaves the process running.
JOB_TIMEOUT_SEC=3600

# Legacy .xls books are converted to .xlsx by LibreOffice headless.
# The Docker image ships headless Calc, so `soffice` is already on PATH.
# Set this only to point at a different binary.
# SOFFICE_BIN=/usr/bin/soffice
# Stop one conversion after this many seconds. Default 300.
# Keep it below JOB_TIMEOUT_SEC so a hung conversion fails the job first.
# XLS_CONVERT_TIMEOUT_SEC=300
LOG_LEVEL=INFO
LOG_JSON=true

# MinIO is optional. Leave the four connection values empty and DuckDB reads
# and writes DATA_DIR only. Set endpoint, bucket, access key, and secret
# together. A partial set fails at startup. DATA_DIR is still written when
# MinIO is set; the bucket receives the same bytes under books/{job_id}/.
# MINIO_PREFIX is an optional key prefix. MINIO_REGION defaults to us-east-1.
# MINIO_ENDPOINT=
# MINIO_BUCKET=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_PREFIX=
# MINIO_REGION=us-east-1
