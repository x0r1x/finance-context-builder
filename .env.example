# Copy to .env (gitignored). Secrets stay out of git.
# OpenAI-compatible LM Studio (or any local server) on host:1234.
# Bare host:1234 gets /v1; /v1 is kept as-is.
# Inside Docker, loopback URLs are rewritten to host.docker.internal
# so the same .env works for uv run and docker compose.

LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_API_KEY=
# Unset LLM_MODEL uses the same default as Settings.llm_model.
LLM_MODEL=qwen3.6-27b-fp8
LLM_CHAT_PATH=/chat/completions
# LLM_TLS_CA_FILE=

EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-mxbai-embed-large-v1
EMBEDDING_PATH=/embeddings
# EMBEDDING_TLS_CA_FILE=
# Optional. Code defaults: batch 32, embed and chat concurrency 1.
# A blank, 0, or negative value keeps that default.
# EMBEDDING_BATCH_SIZE=32
# EMBEDDING_CONCURRENCY=1
# LLM_CONCURRENCY=1
# How many workbooks one process runs at once. Mapping stays one at a time.
# JOB_CONCURRENCY=2

DATA_DIR=data
LLM_SLOT_WAIT_SEC=120
JOB_TIMEOUT_SEC=3600
# DEBUG also logs LLM and embed request and response bodies.
LOG_LEVEL=INFO
LOG_JSON=true
