# Copy to .env (gitignored). Secrets stay out of git.

# Maximum upload size in bytes. Default 50 MiB.
# MAX_UPLOAD_BYTES=52428800
DATA_DIR=data
# One directory under data/sessions/. Default local.
# SESSION_ID=local

# Each accepted workbook runs in its own process.
# How many of those processes may run at once. Default 2.
# A blank, 0, or negative value keeps that default.
# MAX_CONCURRENT_JOBS=2

# RSS cap for one job, in bytes. When unset, the cap is the cgroup memory limit
# (cgroup v2 memory.max, or v1 memory.limit_in_bytes) minus
# JOB_MEMORY_API_RESERVE_FRACTION, split across MAX_CONCURRENT_JOBS.
# A blank or non-positive value keeps the derived cap. A value under
# JOB_MEMORY_FLOOR_BYTES refuses the job and is not raised. A derived share
# under that floor is kept.
# With no cgroup limit and no value here, the cap is
# JOB_MEMORY_DEFAULT_BUDGET_BYTES (1536 MiB, the figure a 4 GiB container
# derives at two slots and the default reserve fraction).
# JOB_MEMORY_BUDGET_BYTES=

# Preflight estimate: base + per formula + per expanded cell + per present cell.
# Defaults are fitted so the ceiling estimate stays about 1.07–1.15 times the
# measured highest-stage peak. A zero per-unit coefficient is allowed.
# JOB_ESTIMATE_BASE_BYTES=138412032
# JOB_ESTIMATE_BYTES_PER_FORMULA=3840
# JOB_ESTIMATE_BYTES_PER_EXPANDED_CELL=960
# JOB_ESTIMATE_BYTES_PER_PRESENT_CELL=960

# Configured JOB_MEMORY_BUDGET_BYTES under this floor refuses the job and is
# not raised. A derived cgroup share under the floor is kept. Default 128 MiB.
# JOB_MEMORY_FLOOR_BYTES=134217728

# Fraction of the cgroup limit kept for the API process, in (0, 1). Default 0.25.
# The rest is split across MAX_CONCURRENT_JOBS.
# JOB_MEMORY_API_RESERVE_FRACTION=0.25

# Budget used when the cgroup reports no limit and JOB_MEMORY_BUDGET_BYTES is
# unset. Default 1536 MiB. Must be a positive integer.
# JOB_MEMORY_DEFAULT_BUDGET_BYTES=1610612736

# How often the parent samples a child's resident set, in seconds. Default 0.2.
# JOB_MEMORY_WATCH_INTERVAL_SEC=0.2

# Cells kept from one bounded range. Whole columns and rows stay present-only.
# Default 2000.
# RANGE_EXPAND_CAP=2000

# oom_score_adj written by the child when the kernel allows it. -1000..1000.
# Default 1000 (prefer killing this process).
# JOB_OOM_SCORE_ADJ=1000

# When true (default), an estimate over the job budget fails the job before
# compile. When false, only the resident-set watchdog refuses the job.
# JOB_MEMORY_PREFLIGHT_REFUSAL=true

# Server: stop a book's process after this many seconds.
# scripts/run.sh reads the same name as a client poll. If it is unset in the
# shell, the script waits 300s and leaves the process running.
JOB_TIMEOUT_SEC=3600

# Legacy .xls books are converted to .xlsx by LibreOffice headless.
# The Docker image ships headless Calc, so `soffice` is already on PATH.
# Set this only to point at a different binary.
# SOFFICE_BIN=/usr/bin/soffice
# Stop one conversion after this many seconds. Default 300.
# Keep it below JOB_TIMEOUT_SEC so a hung conversion fails the job first.
# XLS_CONVERT_TIMEOUT_SEC=300
LOG_LEVEL=INFO
LOG_JSON=true
